# ==============================================================================
# VayuDRISHTI Atmospheric Engine - Backend Environment Variables
# ==============================================================================
#
# Copy to `.env` for defaults you want to commit-safe-track, and to `.env.local`
# for anything secret. `.env.local` is loaded second and overrides `.env`, and
# both `.env` and `.env.local` are git-ignored. `.env.example` is the tracked
# template. Every value below is optional; the defaults in
# `app/core/config.py` reproduce the documented behaviour.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core application
# ------------------------------------------------------------------------------
PROJECT_NAME="VayuDRISHTI Atmospheric Diagnostic Engine"
VERSION="3.0.0"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Comma-separated allowed origins. Wildcards are rejected at load time because
# browsers refuse a wildcard origin when credentials are allowed.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional anchored regex for origins that cannot be listed ahead of time.
# Every Vercel preview deploy gets a unique subdomain, so listing them is
# impossible. Use this to accept production and preview frontends.
# CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# ------------------------------------------------------------------------------
# Domain and forecast definition
# ------------------------------------------------------------------------------
LAT_MIN=8.0
LAT_MAX=37.0
LON_MIN=68.0
LON_MAX=97.0
LEAD_DAY_MIN=1
LEAD_DAY_MAX=10

# A bust is defined as an absolute error in 24-hour accumulated precipitation
# exceeding this many millimetres.
BUST_ERROR_THRESHOLD_MM=25

# Risk bands applied to the calibrated bust probability.
HIGH_RISK_THRESHOLD=0.65
MODERATE_RISK_THRESHOLD=0.35

# ------------------------------------------------------------------------------
# Explainability
# ------------------------------------------------------------------------------
# Exact interventional Shapley values enumerate all 2^13 feature subsets, so the
# inspector (24 background samples) is slower than the map (8 background
# samples, memoised per grid cell).
SHAP_BACKGROUND_SAMPLES=24
GRID_SHAP_BACKGROUND_SAMPLES=8

# ------------------------------------------------------------------------------
# Model artifacts
# ------------------------------------------------------------------------------
# Directory holding bust_model.joblib, error_model.joblib and
# training_report.json. Leave empty to use app/ml_models/ inside the package.
# Artifacts are committed, so no training run is needed to serve predictions.
MODEL_ARTIFACT_DIR=""

# ------------------------------------------------------------------------------
# Optional: generative synoptic briefing
# ------------------------------------------------------------------------------
# Off by default. The deterministic operational_advisory never depends on this.
ENABLE_AI_BRIEFING=false
GEMINI_MODEL="gemini-2.5-flash"
# Put your key in .env.local, never in this tracked file:
# GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Optional: live upstream data sources
# ------------------------------------------------------------------------------
# The prototype serves a generated verification archive and does not require
# these. They are recorded here for the future live-ingestion work.
# OPENWEATHER_API_KEY=""      # https://home.openweathermap.org/users/sign_up
# ECMWF_API_KEY=""            # https://cds.climate.copernicus.eu/
NOAA_NOMADS_BASE_URL="https://nomads.ncep.noaa.gov/dods/gfs_0p25"
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
