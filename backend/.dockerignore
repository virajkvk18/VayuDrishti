__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# Source control and docs.
.git/
.gitignore
README.md
Dockerfile
.dockerignore

# Tests are run in CI, not at runtime.
tests/
