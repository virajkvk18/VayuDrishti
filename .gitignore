# --- Secrets & local overrides (NEVER commit) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Tool scratch space ---
# Local agent/tool worktrees. These are nested git repos, so git will not recurse
# into them anyway, but ignoring the directory stops a stray copy of the project
# (including its .env) from ever being staged.
.kilo/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- OS ---
.DS_Store
Thumbs.db
